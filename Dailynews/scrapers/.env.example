# .env.example
# Copy this file to .env and fill in your real values.
# Never commit .env to git — it's in .gitignore.

# ---------------------------------------------------------------------------
# SUPABASE
# Find these in: Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------------------------------------------------------------------------
# LLM PROVIDER
# ACTIVE_LLM: "gemini" (testing) or "claude" (production)
# Only the key for the active provider is required
# ---------------------------------------------------------------------------
ACTIVE_LLM=gemini

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-3-haiku-20240307

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------
HUGGINGFACE_API_KEY=your-hf-token-here

# ---------------------------------------------------------------------------
# PIPELINE CONFIG (defaults shown — change only if needed)
# ---------------------------------------------------------------------------
SCHEDULER_INTERVAL_MINUTES=30
FREE_TIER_RELEASE_HOUR_UTC=4
FREE_TIER_DAILY_LIMIT=20
MAX_CONTENT_CHARS=2000
MAX_CONCURRENT_SUMMARIES=5
LLM_MAX_OUTPUT_TOKENS=150

# ---------------------------------------------------------------------------
# SECURITY
# ---------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to "false" in production to disable /docs endpoint
ENABLE_DOCS=true